<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.daeryun.probank.dao.AuditLogDao">

    <!--
        detail is stored as PostgreSQL JSONB. Binding a plain String parameter directly to a jsonb
        column fails with "column is of type jsonb but expression is of type character varying"
        because the JDBC driver sends the bound parameter as varchar and Postgres does not apply an
        implicit assignment cast in that context. An explicit CAST(... AS jsonb) fixes this; CAST
        also tolerates a NULL parameter (detail is nullable), so no separate null-handling is needed.
    -->
    <insert id="insert" parameterType="com.daeryun.probank.domain.AuditLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO audit_logs (actor_id, action, target_type, target_id, detail)
        VALUES (#{actorId}, #{action}, #{targetType}, #{targetId}, CAST(#{detail} AS jsonb))
    </insert>

</mapper>
